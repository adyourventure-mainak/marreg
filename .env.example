# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9R-8oEfFi1N5r7WknNsR2Q_hb8042GY

# Public origin of the deployed site — used for auth email + OAuth redirects.
NEXT_PUBLIC_SITE_URL=https://marreg.vercel.app

# ---------------------------------------------------------------------------
# Document extraction worker (/api/extraction, driven by Vercel Cron).
# All server-side only. None of these may ever be prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Bypasses RLS. Used by the worker and by scripts/import-offices.ts.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron requests.
# The worker refuses every request if this is unset — it never runs open.
CRON_SECRET=generate_a_long_random_string

# Vision model. Any OpenAI-compatible endpoint works; only these three change.
# The model must support BOTH image input and strict json_schema structured
# outputs — the pipeline validates the response and fails the job if the model
# drifts from the schema. gpt-4o-mini is the documented cheap tier that does
# both; check your account's model list for a newer one before going live.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EXTRACTION_MODEL=gpt-4o-mini
AI_ASSISTANT_MODEL=gpt-5.6-luna
AI_API_KEY=replace_with_server_only_ai_key

# Salt for the anonymous objection rate-limit digest. Any long random string.
OBJECTION_SALT=
