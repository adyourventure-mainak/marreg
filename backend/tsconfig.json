{
  "compilerOptions": {
    "module": "commonjs", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "target": "ES2022", "sourceMap": true,
    "outDir": "./dist", "baseUrl": "./", "incremental": true,
    "skipLibCheck": true, "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "strictPropertyInitialization": true,
    "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"], "exclude": ["node_modules", "dist"]
}
